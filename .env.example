# Copy to .env for local dev. In production these are set in the Railway dashboard.

# Postgres connection string. Railway provides this automatically as DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/gopherpath

# Anthropic API key (used for APAS parsing, plan explanation, and chat).
ANTHROPIC_API_KEY=sk-ant-...

# Production frontend origin, used for CORS (e.g. https://gopherpath.vercel.app).
# Optional locally; Vercel preview URLs (*.vercel.app) are always allowed via regex.
FRONTEND_ORIGIN=
